{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Consolidador de Ingredientes",
  "version": "1.0.0",
  "identifier": "com.diegg.appgastronomia",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Consolidador de Ingredientes",
        "width": 1280,
        "height": 720,
        "maximized": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [
        "https://github.com/DieggoAn/appGastronomia/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQxRTMxNTEyMDVFQ0IzQkEKUldTNnMrd0ZFaFhqMFNGVk04QldscUxWREt1MEhtV3VxWmZiMTJWVXFIRTRCMXI5TEkyQldya2MK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}